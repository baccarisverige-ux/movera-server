{
  "name": "movera-server",
  "version": "0.1.0",
  "private": true,
  "description": "Movera backend: one server for the rider, driver and admin apps, built against movera-contracts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "MOVERA_ENV=development tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrateCli.ts",
    "admin": "tsx src/admin/cli.ts",
    "contract:verify": "cd contracts && sha256sum -c --quiet CHECKSUMS && echo contract ok",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "kysely": "^0.28.18",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
